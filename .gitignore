# ==========================================
# Root .gitignore for Wayang Monorepo
# ==========================================

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Code Editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# Environment & Secret Files (Zero-Trust)
.env
.env.*
!.env.example
*.key
*.pem
*.cer
*.crt
*.pfx
*.p12
auth.json

# Database Dumps & SQLite
*.sql
*.sqlite
*.sqlite3
*.db
*.dump

# Logs, Archives & Temporary Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.zip
*.tar
*.gz
*.tar.gz
*.rar
*.7z
*.bak
*.tmp
*.temp

# Dependencies & Build Artefacts
node_modules/
vendor/
dist/
build/
.phpunit.cache/
