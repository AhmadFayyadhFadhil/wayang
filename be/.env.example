# ========================================================
# PENGATURAN UTAMA APLIKASI
# ========================================================
APP_NAME="Wayang Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true # Ubah ke false di production
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

# Lokalisasi (Bahasa Indonesia untuk tema kultural pewayangan)
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ========================================================
# LOGGING
# ========================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ========================================================
# KONEKSI DATABASE (MySQL via XAMPP)
# Catatan: Buat database "wayang" di phpMyAdmin sebelum migrate
# ========================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wayang
DB_USERNAME=root
DB_PASSWORD=

# ========================================================
# SESSION, CACHE & QUEUE DRIVER
# Driver "database" memerlukan eksekusi migrasi tabel awal
# ========================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# ========================================================
# AUTENTIKASI SPA & CORS
# ========================================================
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ========================================================
# LAYANAN EKSTERNAL (DUMMY / OPSIONAL)
# ========================================================
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@wayangdigital.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
